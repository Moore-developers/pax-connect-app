  "messages": {
    "onboarding.welcome_title": "Get Started with Pax Connect",
    "onboarding.welcome_detail": "Connect your network and inspect traffic routes, or view local AI usage directly. Bring your own routes or subscription. Usage comes from local client logs.",
    "onboarding.configure_network": "Set Up Network",
    "onboarding.view_usage": "View AI Usage",
    "onboarding.first_route_title": "1 · Add Your First Route",
    "onboarding.first_route_detail": "Import a share link or HTTPS subscription, or add a route manually in Routes.",
    "onboarding.import_routes": "Import Routes",
    "onboarding.no_route_help": "No Route or Subscription?",
    "onboarding.select_title": "1 · Select a Route to Connect",
    "onboarding.select_detail": "Your routes are saved. Select a route in its row to connect. You can test its speed later.",
    "onboarding.select_route": "Select Route",
    "onboarding.connect_title": "2 · Enable the Proxy",
    "onboarding.connect_detail": "A route is selected. Network takeover begins when you enable the proxy. Authorization is requested if administrator privileges are needed.",
    "onboarding.connect": "Enable Proxy",
    "onboarding.other_route": "Select Another Route",
    "onboarding.waiting_title": "3 · Wait for Network Activity",
    "onboarding.waiting_detail": "Connected. Open a website you normally use. Network records will appear automatically in Traffic and Logs.",
    "onboarding.view_traffic": "View Traffic",
    "onboarding.view_logs": "View Logs",
    "onboarding.network_recording": "Network Activity Is Being Recorded",
    "onboarding.network_complete_detail": "Traffic shows applications and destinations. Logs show access results and problems. Saved history remains available with the proxy off.",
    "onboarding.complete": "Finish Setup",
    "onboarding.usage_loaded": "Local AI Usage Loaded",
    "onboarding.usage_loaded_detail": "Records may include history from before Pax was installed. Cost is a local estimate. You can manage Profiles later.",
    "onboarding.manage_profiles": "Manage Profiles",
    "onboarding.usage_title": "View Local AI Usage",
    "onboarding.usage_detail": "Claude Code, Codex, and DSH are supported. Existing logs appear directly. If there are no records, complete one request in your client. Enabling the proxy or creating a Profile first is optional.",
    "onboarding.usage_action": "View Usage",
    "onboarding.bring_routes_title": "Bring Your Own Routes or Subscription",
    "onboarding.bring_routes_detail": "Get a share link, HTTPS subscription, or server parameters from your network provider. Pax does not supply servers. Import or add them in Routes, or continue later.",
    "onboarding.understood": "Got It",
    "onboarding.later": "Later"
  }
