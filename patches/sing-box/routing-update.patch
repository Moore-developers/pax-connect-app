+// ReplaceRules swaps a validated, started rule table for new connections only.
+// Existing routed sockets retain their outbound; no instance or TUN is restarted.
+func (r *Router) ReplaceRules(options []option.Rule) error { return r.ReplaceNamedRules(options, nil) }
+func (r *Router) ReplaceNamedRules(options []option.Rule, names []string) error {
+	if len(names) > 0 && len(names) != len(options) {
+		return E.New("rule labels mismatch")
+	}
+	candidate := make([]adapter.Rule, 0, len(options))
+	cleanup := func() {
+		for _, rule := range candidate {
+			_ = rule.Close()
+		}
+	}
+	for i, value := range options {
+		if err := R.ValidateNoNestedRuleActions(value); err != nil {
+			cleanup()
+			return err
+		}
+		rule, err := R.NewRule(r.ctx, r.logger, value, false)
+		if err != nil {
+			cleanup()
+			return err
+		}
+		if i < len(names) {
+			rule = paxNamedRule{Rule: rule, label: names[i]}
+		}
+		candidate = append(candidate, rule)
+	}
+	r.paxRulesMu.Lock()
+	defer r.paxRulesMu.Unlock()
+	if !r.paxStarted {
+		cleanup()
+		return E.New("router not started")
+	}
+	for _, rule := range candidate {
+		if err := rule.Start(); err != nil {
+			cleanup()
+			return err
+		}
+	}
+	previous := r.rules
+	r.rules = candidate
+	for _, rule := range previous {
+		_ = rule.Close()
+	}
+	return nil
+}
+
+type paxNamedRule struct {
+	adapter.Rule
+	label string
+}
+
+func (r paxNamedRule) String() string { return r.label }
