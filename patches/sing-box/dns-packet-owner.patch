+// FindDNSPacketOwner identifies a single possible sender of this UDP packet.
+// Even a matching connected socket may share the wire tuple with an
+// unconnected socket using SO_REUSEPORT.
+func (*darwinSearcher) FindDNSPacketOwner(source, destination netip.AddrPort) (*adapter.ConnectionOwner, error) {
+	source = normalizeDarwinAddrPort(source)
+	destination = normalizeDarwinAddrPort(destination)
+	snapshot, err := buildDarwinSnapshotForFamily(N.NetworkUDP, source.Addr().Is6())
+	if err != nil {
+		return nil, err
+	}
+	entry, err := matchDarwinDNSPacketOwner(snapshot.entries, source, destination)
+	if err != nil {
+		return nil, err
+	}
+	path, err := getExecPathFromPID(entry.pid)
+	if err != nil {
+		return nil, err
+	}
+	return &adapter.ConnectionOwner{UserId: entry.uid, ProcessPath: path}, nil
+}
+
+func matchDarwinDNSPacketOwner(entries []darwinConnectionEntry, source, destination netip.AddrPort) (darwinConnectionEntry, error) {
+	sourceAddr := source.Addr()
+	if !source.IsValid() || !destination.IsValid() || source.Port() == 0 || destination.Port() == 0 {
+		return darwinConnectionEntry{}, ErrNotFound
+	}
+	var owner darwinConnectionEntry
+	for _, entry := range entries {
+		if entry.localPort != source.Port() || sourceAddr.BitLen() != entry.localAddr.BitLen() ||
+			(entry.localAddr != sourceAddr && !entry.localAddr.IsUnspecified()) {
+			continue
+		}
+		connectedToDestination := entry.remotePort == destination.Port() && entry.remoteAddr == destination.Addr()
+		unconnected := entry.remotePort == 0 && entry.remoteAddr.IsUnspecified()
+		if !connectedToDestination && !unconnected {
+			continue
+		}
+		if entry.pid == 0 || (owner.pid != 0 && (entry.pid != owner.pid || entry.uid != owner.uid)) {
+			return darwinConnectionEntry{}, ErrNotFound
+		}
+		owner = entry
+	}
+	if owner.pid == 0 {
+		return darwinConnectionEntry{}, ErrNotFound
+	}
+	return owner, nil
 }

