+// Only the native Darwin searcher needs to disambiguate shared UDP ports. The
+// callback takes a fresh snapshot for each datagram, including on reused flows.
+func (r *Router) dnsPacketOwnerLookup() func(context.Context, *adapter.InboundContext) {
+	searcher, ok := r.processSearcher.(interface {
+		FindDNSPacketOwner(source, destination netip.AddrPort) (*adapter.ConnectionOwner, error)
+	})
+	if !ok {
+		return nil
+	}
+	return func(ctx context.Context, metadata *adapter.InboundContext) {
+		metadata.ProcessInfo = nil
+		if !r.isLocalSource(metadata.Source.Addr) {
+			paxobs.Emit(ctx, paxobs.Event{Stage: "identity", ProcessStatus: "non_local"})
+			return
+		}
+		destination := metadata.Destination
+		if metadata.OriginDestination.IsIP() {
+			destination = metadata.OriginDestination
+		}
+		if !destination.IsIP() {
+			paxobs.Emit(ctx, paxobs.Event{Stage: "identity", ProcessStatus: "not_found"})
+			return
+		}
+		owner, err := searcher.FindDNSPacketOwner(metadata.Source.AddrPort(), destination.AddrPort())
+		switch {
+		case errors.Is(err, process.ErrNotFound):
+			paxobs.Emit(ctx, paxobs.Event{Stage: "identity", ProcessStatus: "not_found"})
+		case err != nil:
+			paxobs.Emit(ctx, paxobs.Event{Stage: "identity", ProcessStatus: "lookup_failed"})
+		case owner.ProcessPath == "":
+			paxobs.Emit(ctx, paxobs.Event{Stage: "identity", ProcessStatus: "path_unavailable"})
+		default:
+			metadata.ProcessInfo = owner
+			paxobs.Emit(ctx, paxobs.Event{Stage: "identity", Process: owner.ProcessPath, ProcessStatus: "identified"})
+		}
+	}
+}
