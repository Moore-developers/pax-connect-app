+	if metadata.ProcessInfo != nil {
+		process = metadata.ProcessInfo.ProcessPath
+	}
+	queryCtx, finish := paxobs.BeginDNS(ctx, message, metadata.Network, metadata.InboundType, process)
+	return adapter.WithContext(queryCtx, &metadata), finish
+}
